# App Configuration
APP__NAME="Daily Content Agent"
APP__ENVIRONMENT="development"
APP__LOG_LEVEL="INFO"
# Public HTTPS base so Instagram can fetch generated images (ngrok / tunnel)
APP__PUBLIC_BASE_URL=""

# AI Provider Configuration
# Providers: openrouter | openai
# DeepSeek via OpenRouter is for TEXT (LinkedIn/Instagram drafts), not images.
AI__PROVIDER="openrouter"
AI__API_KEY=""
AI__MODEL_NAME="deepseek/deepseek-v4-flash-0731"

# Research Configuration
RESEARCH__MAX_SOURCES=5
RESEARCH__SEARCH_API_KEY=""

# Image Generation Configuration
# Providers: puter | dalle | gemini | openrouter | mock
IMAGE__PROVIDER="puter"
IMAGE__API_KEY=""
IMAGE__RESOLUTION="1024x1024"
IMAGE__MODEL_NAME="openai/gpt-image-2"

# LinkedIn Configuration
LINKEDIN__CLIENT_ID=""
LINKEDIN__CLIENT_SECRET=""
LINKEDIN__ACCESS_TOKEN=""
LINKEDIN__AUTHOR_URN=""

# Instagram Configuration (Graph API)
INSTAGRAM__ACCOUNT_ID=""
INSTAGRAM__ACCESS_TOKEN=""
# Optional Facebook Place ID to geotag posts (Graph API location / pages search)
INSTAGRAM__LOCATION_ID=""
INSTAGRAM__LOCATION_NAME=""
# Instagram feed: 1 = single image (most reliable); 2–7 = carousel (slower / Puter timeouts)
INSTAGRAM__CAROUSEL_SLIDES=1

# Database Configuration
# Local desktop: sqlite. SaaS: paste Supabase Postgres URI (Transaction pooler).
DB__CONNECTION_STRING="sqlite:///initials_agent.db"

# ---------------------------------------------------------------------------
# SaaS — Supabase + React (see docs/SAAS_SETUP.md)
# ---------------------------------------------------------------------------
SAAS__ENABLED=false
SAAS__CRON_SECRET="change-me-to-a-long-random-string"
SAAS__CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175"
# Comma-separated emails that can open /admin (fail closed if empty)
SAAS__ADMIN_EMAILS="you@example.com"

SUPABASE__URL="https://YOUR_PROJECT.supabase.co"
SUPABASE__ANON_KEY=""
SUPABASE__SERVICE_ROLE_KEY=""
SUPABASE__STORAGE_BUCKET="post-images"

# Scheduling Configuration
SCHEDULING__TIMEZONE="Asia/Kolkata"
SCHEDULING__PUBLISH_TIME="09:00"

# Notifications Configuration
NOTIFICATIONS__SLACK_WEBHOOK_URL=""
